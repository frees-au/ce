<?php

/**
 * @file
 * Free Sauce theme module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function fstheme_theme_suggestions_field_alter(array &$hooks, array $vars): void {
  switch ($vars['element']['#field_type'] ?? NULL) {
    case 'string':
    case 'list_string':
    case 'text_long':
    case 'link':
    case 'created':
    case 'boolean':
    case 'image':
    case 'entity_reference':
    case 'entity_reference_revisions':
    case 'block_field':
      $hooks[] = 'field__bare';
      return;

    default:
      \Drupal::messenger()->addError('Unexpected field type ' . $vars['element']['#field_type'] . ' not sure if to wrap it in a bare template.');
      break;
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * For article nodes:
 *  - sets $article_type to 'video' if a YouTube (media:stream) ref is present
 *  - leaves $url as the Drupal node path so the teaser links to the article,
 *    not the YouTube watch page (target stays _self)
 *  - sets $youtube_thumbnail to a renderable thumbnail built from the
 *    referenced media's oEmbed-derived `thumbnail` image field. The teaser
 *    template uses this as the cover image instead of a stock fallback.
 */
function fstheme_preprocess_node(&$vars) {
  $node = $vars['node'];
  if (!($node instanceof NodeInterface) || $node->bundle() !== 'article') {
    return;
  }

  if (!$node->hasField('youtube') || $node->get('youtube')->isEmpty()) {
    return;
  }

  $media = $node->get('youtube')->entity;
  if (!($media instanceof MediaInterface)) {
    return;
  }

  $vars['article_type'] = 'video';

  // Build a renderable thumbnail from the YouTube media's thumbnail field.
  // oEmbed populates this on save with the YouTube `hqdefault` jpg.
  if ($media->hasField('thumbnail') && !$media->get('thumbnail')->isEmpty()) {
    $image = $media->get('thumbnail')->entity;
    if ($image instanceof EntityInterface) {
      $vars['youtube_thumbnail'] = [
        '#theme' => 'image_style',
        '#style_name' => 'teaser',
        '#uri' => $image->getFileUri(),
        '#alt' => $node->label(),
        '#title' => $node->label(),
      ];
    }
  }

  // Expose the YouTube playlist URL (if any) so the article template can
  // render a "Watch the playlist on YouTube" link below the embed.
  if ($media->hasField('field_playlist_url') && !$media->get('field_playlist_url')->isEmpty()) {
    $vars['youtube_playlist_url'] = $media->get('field_playlist_url')->getValue()[0];
  }

  // Expose any local Playlists-view links so the article (full + teaser)
  // can show a "Part of: <playlist>" link to /playlists/<tid>. Only articles
  // that have at least one taxonomy term in the 'playlist' vocabulary get
  // this — empty otherwise.
  if ($node->hasField('playlist') && !$node->get('playlist')->isEmpty()) {
    $terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadMultiple(array_column($node->get('playlist')->getValue(), 'target_id'));
    $links = [];
    foreach ($terms as $term) {
      if ($term->bundle() !== 'playlist') {
        continue;
      }
      $links[] = [
        'label' => $term->label(),
        'url'   => '/playlists/' . $term->id(),
      ];
    }
    if ($links) {
      $vars['article_playlists'] = $links;
    }
  }
}
