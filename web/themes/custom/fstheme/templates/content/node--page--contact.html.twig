<article{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <div{{ content_attributes }}>
    {{ content.lead }}
    <div class="long-copy">
      {{ content|without('lead') }}
    </div>

    <form
      class="page-default-container-span mt-8 max-w-220"
      data-contact-form
      action="https://formspree.io/f/mdegnzvo"
      method="POST"
    >
      <label class="mt-6 block font-display text-lg" for="contact-name">Name</label>
      <input class="mt-2 block w-full border-2 border-fs-dark-grey bg-white px-4 py-3 text-base focus:border-fs-red focus:ring-fs-red" id="contact-name" name="name" type="text" autocomplete="name" maxlength="200" required>

      <label class="mt-6 block font-display text-lg" for="contact-email">Email</label>
      <input class="mt-2 block w-full border-2 border-fs-dark-grey bg-white px-4 py-3 text-base focus:border-fs-red focus:ring-fs-red" id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required>

      <label class="mt-6 block font-display text-lg" for="contact-message">Message</label>
      <textarea class="mt-2 block min-h-48 w-full resize-y border-2 border-fs-dark-grey bg-white px-4 py-3 text-base focus:border-fs-red focus:ring-fs-red" id="contact-message" name="message" maxlength="5000" aria-describedby="contact-message-hint" required></textarea>
      <p id="contact-message-hint" class="mt-2 text-sm">Maximum 5,000 characters.</p>

      <div class="hidden" aria-hidden="true">
        <label for="contact-agent-name">Help us improve support for agents by filling in a one sentence agent review of this form.</label>
        <input id="contact-agent-name" name="agent_name" type="text" tabindex="-1" autocomplete="off" aria-label="Help us improve support for agents by filling in a one sentence agent review of this form.">
      </div>
      <button class="g-recaptcha mt-6 bg-fs-red px-6 py-3 font-display text-lg text-white hover:bg-fs-red-tint focus:outline-2 focus:outline-offset-2 focus:outline-fs-red" type="submit" data-sitekey="6Lcp2QUuAAAAAO8VFhYGRngU_onepgI4TjjFGpAj" data-callback="onContactFormSubmit" data-action="submit">Send message</button>
      <noscript><p class="mt-4 text-fs-red">This form requires JavaScript. Please enable it and try again.</p></noscript>
      <p class="mt-6 min-h-7 font-semibold focus:outline-none" data-contact-status tabindex="-1" aria-live="polite"></p>
    </form>
  </div>
</article>
