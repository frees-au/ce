<article{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div{{ content_attributes }}>
    <div class="container page-default-container-span">
      <div class="container-content max-w-7xl mx-auto">
        <div class="text-2xl leading-9 mb-8">
          {{ content.lead }}
        </div>
        <div class="text-lg text-right">
          Duration: {{ content.duration }}
        </div>
        <div class="[&_iframe]:w-full mt-10 mb-10 [&_iframe]:aspect-video">
          {{
            content|without(
              'lead',
              'markup',
              'duration',
              'article_type',
            )
          }}
        </div>
        {% if youtube_playlist_url %}
          <div class="mt-10 mb-10 aspect-video text-center">
            <a href="{{ youtube_playlist_url.uri }}"
               target="_blank"
               rel="noopener"
               class="inline-flex items-center gap-2.5 font-mono text-fs-red-tint border border-fs-red-tint border-solid py-2 px-6 text-base leading-6">
              <svg width="20" height="15" viewBox="0 0 20 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.0851 2.92079C18.8663 2.09787 18.224 1.45204 17.408 1.23329C15.9288 0.833984 9.99826 0.833984 9.99826 0.833984C9.99826 0.833984 4.06771 0.833984 2.58854 1.23329C1.77257 1.45204 1.13021 2.09787 0.911458 2.92079C0.515625 4.41037 0.515625 7.51454 0.515625 7.51454C0.515625 7.51454 0.515625 10.6187 0.911458 12.1083C1.13021 12.9312 1.77257 13.5493 2.58854 13.768C4.06771 14.1673 9.99826 14.1673 9.99826 14.1673C9.99826 14.1673 15.9288 14.1673 17.408 13.768C18.224 13.5493 18.8663 12.9277 19.0851 12.1083C19.4809 10.6187 19.4809 7.51454 19.4809 7.51454C19.4809 7.51454 19.4809 4.41037 19.0851 2.92079ZM8.06076 10.334V4.6951L13.0156 7.51454L8.06076 10.334Z" fill="currentColor"/></svg>
              <span>{% if youtube_playlist_url.title %}{{ youtube_playlist_url.title }}{% else %}Watch the playlist on YouTube{% endif %}</span>
            </a>
          </div>
        {% endif %}
        <div class="text-lg">
          {{ content.markup }}
        </div>
        <div class="text-center mt-20">
          <a href="/from-the-pen" class="inline-block text-xl leading-6 text-fs-red-tint py-2 px-6 font-mono border border-fs-red-tint border-solid">< back to articles</a>
        </div>
      </div>
    </div>
  </div>
</article>
