<?php

/**
 * @file
 * Main fs module file.
 */

declare(strict_types=1);

use Drupal\taxonomy\TermInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_requirements_alter().
 *
 * @phpstan-param array<string, mixed> $requirements
 */
function fs_requirements_alter(array &$requirements): void {
  // Decrease the 'update status' requirement severity from warning to informational.
  if (isset($requirements['update status']) && is_array($requirements['update status'])) {
    $requirements['update status']['severity'] = REQUIREMENT_INFO;
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Exposes a `$page_header_image` for every page route, even those without a
 * node (view pages like /from-the-pen, taxonomy term pages, and the homepage
 * redirect), so the header always has a background image.
 *
 * @phpstan-param array<string, mixed> $vars
 */
function fs_preprocess_page(array &$vars): void {
  $vars['page_header_image'] = _fs_random_stockart();
}

/**
 * Returns a random URL to one of the stockart JPGs in the fstheme.
 */
function _fs_random_stockart(): string {
  return '/themes/custom/fstheme/stockart/stock-'
    . str_pad((string) rand(1, 105), 3, '0', STR_PAD_LEFT)
    . '.jpg';
}

/**
 * Implements hook_views_pre_view().
 *
 * On the `playlists` view, override the page title with the resolved
 * taxonomy term name when a tid is supplied via the URL — the default
 * contextual-filter title token resolves to the raw ID, not the label.
 *
 * Example: /playlists/1/videos  →  page title becomes "Vibecoding a
 * Firebase App", not "1".
 *
 * @phpstan-param array<int, mixed> $args
 */
function fs_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'playlists') {
    return;
  }
  $title = _fs_playlist_title($view);
  if ($title !== NULL) {
    $view->setTitle($title);
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Counterpart to fs_views_pre_view() — execute() resets the title to the
 * default at runtime, so the override has to land in pre_render.
 */
function fs_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== 'playlists') {
    return;
  }
  $title = _fs_playlist_title($view);
  if ($title !== NULL) {
    $view->setTitle($title);
  }
}

/**
 * Resolves the playlist title from a view's first contextual argument.
 */
function _fs_playlist_title(ViewExecutable $view): ?string {
  $argument = $view->args[0] ?? NULL;
  if (!is_int($argument) && !is_string($argument)) {
    return NULL;
  }
  $tid = filter_var($argument, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
  if ($tid === FALSE) {
    return NULL;
  }
  $term = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->load($tid);
  return $term instanceof TermInterface && $term->bundle() === 'playlist'
    ? (string) $term->label()
    : NULL;
}
