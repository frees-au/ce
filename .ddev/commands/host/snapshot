#!/bin/bash

set -euo pipefail

DB="_db_main.sqlite"
SNAPSHOT="_snapshot.sql"
SNAPSHOT_CHECK="_db_main.sqlite.sqlite"

if [ ! -f "$DB" ]; then
  echo "Missing $DB."
  exit 1
fi

sqlite3 "$DB" \
  "SELECT printf('DELETE FROM \"%w\";', name)
   FROM sqlite_schema
   WHERE type = 'table'
     AND name LIKE 'cache\_%' ESCAPE '\'
   ORDER BY name;" \
  | sqlite3 "$DB"

sqlite3 "$DB" "DELETE FROM router; PRAGMA auto_vacuum = FULL; VACUUM;"
sqlite3 "$DB" "PRAGMA wal_checkpoint(TRUNCATE);" > /dev/null
sqlite3 "$DB" "PRAGMA journal_mode = DELETE;" > /dev/null
sqlite3 "$DB" .dump > "$SNAPSHOT"
rm -f "$SNAPSHOT_CHECK" "$SNAPSHOT_CHECK-shm" "$SNAPSHOT_CHECK-wal"
sqlite3 _db_main.sqlite.sqlite < _snapshot.sql

echo "Site compressed, ready to commit."
